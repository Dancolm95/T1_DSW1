@model IEnumerable<Libro>

@{
    ViewData["Title"] = "Lista de libros";
}

<h1>Lista de libros</h1>
<p>@ViewBag.Mensaje</p>
<a asp-controller="Libro" asp-action="Crear" class="btn btn-primary mb-3">
    Registrar libro
</a>

@using (Html.BeginForm("Buscar", "Libro", FormMethod.Get))
{
    <label for="autor">Buscar por autor</label>
    <input type="text" id="autor" name="autor"
           class="form-control d-inline-block w-auto" required />
    <button type="submit" class="btn btn-outline-primary">Buscar</button>
}

<table class="table table-striped table-hover align-middle">
    <tr>
        <th>Id</th>
        <th>Nombre del libro</th>
        <th>Autor</th>
        <th>Editorial</th>
        <th>ISDN</th>
        <th>Acciones</th>
    </tr>

    @foreach (var item in Model)
    {
        <tr>
            <td>@Html.DisplayFor(modelItem => item.Id)</td>
            <td>@Html.DisplayFor(modelItem => item.NombreLibro)</td>
            <td>@Html.DisplayFor(modelItem => item.Autor)</td>
            <td>@Html.DisplayFor(modelItem => item.NombreEditorial)</td>
            <td>@Html.DisplayFor(modelItem => item.ISDN)</td>
            <td>
                <a asp-action="Editar" asp-route-id="@item.Id"
                   class="btn btn-sm btn-outline-secondary">Editar</a>

                   @using (Html.BeginForm("Eliminar", "Libro",
                   new { id = item.Id}, FormMethod.Post))
                {
                <input type="submit" value="Eliminar"
                       class="btn btn-sm btn-outline-danger"
                       onclick="return confirm('¿Está seguro de que desea eliminar este libro?');" />                }
            </td>
        </tr>
    }
</table>

@if (ViewBag.Pagina > 1)
{
    @Html.ActionLink("Anterior", "Index", new { pagina = ViewBag.Pagina - 1 })
}

<span>Página @ViewBag.Pagina</span>

@if (ViewBag.HaySiguiente)
{
    @Html.ActionLink("Siguiente", "Index", new { pagina = ViewBag.Pagina + 1 })
}